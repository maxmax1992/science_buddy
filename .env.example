# Copy to .env.local if you want to override defaults. Nothing here is required.
# Claude runs through your logged-in Claude Code CLI subscription (`claude auth login`) — no API key.
# SB_CHAT_MODEL=sonnet
# SB_TRANSCRIBE_MODEL=sonnet
# Local voice (mlx-audio, `npm run voice`)
# SB_VOICE_URL=http://127.0.0.1:8765
# SB_ASR_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# SB_TTS_MODEL=mlx-community/Kokoro-82M-bf16
# SB_TTS_VOICE=af_heart
